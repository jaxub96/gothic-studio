{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Gothic Studio (dev)",
            "type": "shell",
            "command": "${workspaceFolder}\\dev.bat",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Selftest",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe selftest.py",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        }
    ]
}
